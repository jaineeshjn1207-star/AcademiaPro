# ==============================================================================
# AcademiaPro — Unified Monorepo Environment Variables Reference
# ==============================================================================
# Copy this file to backend/.env and frontend/.env respectively, or configure
# these variables in your deployment platform's environment settings.
# ==============================================================================

# --- BACKEND SETTINGS (backend/.env) ---
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-secure-random-string-in-production
DJANGO_ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173
FRONTEND_URL=https://app.example.com

# Database Connection (PostgreSQL Recommended for Production)
DATABASE_URL=postgresql://user:password@hostname:5432/academiapro_db
DJANGO_DB_CONN_MAX_AGE=600

# Security & HTTPS (Set to True in production)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# AI Features (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# --- FRONTEND SETTINGS (frontend/.env) ---
VITE_API_BASE_URL=https://api.example.com/api/
VITE_SHOW_DEMO_CREDENTIALS=false
