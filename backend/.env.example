# ==============================================================================
# AcademiaPro Backend — Production & Development Environment Variables
# ==============================================================================
# Copy this file to .env before starting the backend:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
# Set to True for local development, False for production deployment.
# In production, DEBUG=False is critical to prevent leaking tracebacks and secrets.
DJANGO_DEBUG=False

# A strong, unique random secret key for cryptographic signing (sessions, tokens).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# REQUIRED in all environments.
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Comma-separated list of hostnames/domain names this Django site can serve.
# In production, set to your actual domain(s) (e.g. api.academiapro.com,academiapro-api.onrender.com).
# In development (DEBUG=True), defaults to '*' if omitted.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com

# Comma-separated list of trusted origins for unsafe (POST/PUT/DELETE) requests.
# Must include the scheme (http:// or https://).
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com,http://localhost:5173

# ------------------------------------------------------------------------------
# CORS & FRONTEND INTEGRATION
# ------------------------------------------------------------------------------
# Comma-separated list of origins allowed to make cross-origin AJAX/fetch requests.
# In development (DEBUG=True), CORS_ALLOW_ALL_ORIGINS is enabled automatically.
# In production (DEBUG=False), you must specify your frontend domain(s) here.
CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173

# The public URL of the React frontend.
# Used for generating user-facing links (e.g. password reset emails).
FRONTEND_URL=https://app.example.com

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option 1: Standard PostgreSQL / MySQL / SQLite Connection URL (RECOMMENDED for Cloud)
# If DATABASE_URL is set, it takes precedence over individual DB_* variables.
# PostgreSQL Example: postgresql://username:password@hostname:5432/dbname?sslmode=require
# SQLite Example (Dev): sqlite:///db.sqlite3
DATABASE_URL=postgresql://user:password@localhost:5432/academiapro_db

# Option 2: Individual Database Parameters (Fallback if DATABASE_URL is not set)
DB_NAME=academiapro_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Database connection pooling max age in seconds (default: 600)
DJANGO_DB_CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# HTTPS & SECURITY HEADERS (PRODUCTION)
# ------------------------------------------------------------------------------
# Redirect all non-HTTPS requests to HTTPS. Set to True in production if not handled by reverse proxy.
DJANGO_SECURE_SSL_REDIRECT=True

# Transmit session and CSRF cookies over HTTPS connections only.
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# HTTP Strict Transport Security (HSTS) settings.
# 31536000 seconds = 1 year. Set to 0 to disable HSTS during testing.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False

# ------------------------------------------------------------------------------
# ARTIFICIAL INTELLIGENCE & EVALUATION (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# Google Gemini API key used for AI Tutor and automated coding evaluation features.
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model identifier (e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# EMAIL SERVICE CONFIGURATION (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# Backend: django.core.mail.backends.smtp.EmailBackend (production) or
#          django.core.mail.backends.console.EmailBackend (development)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@academiapro.com
DJANGO_EMAIL_HOST=smtp.sendgrid.net
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=apikey
DJANGO_EMAIL_HOST_PASSWORD=your-smtp-api-key
DJANGO_EMAIL_USE_TLS=True

# ------------------------------------------------------------------------------
# CLOUDFLARE R2 OBJECT STORAGE (PRODUCTION MEDIA ATTACHMENTS & RECORDINGS)
# ------------------------------------------------------------------------------
# Leave blank to fall back to local FileSystemStorage in development.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=academiapro-media
# R2_ENDPOINT_URL is optional; auto-computed as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_URL_EXPIRY=3600

