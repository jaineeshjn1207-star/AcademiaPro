# ==============================================================================
# AcademiaPro Frontend — Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the frontend:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# API BASE URL
# ------------------------------------------------------------------------------
# The full HTTP/HTTPS URL of the AcademiaPro backend API, ending with '/api/'.
#
# Examples:
#   Local Development: http://127.0.0.1:8000/api/
#   Production:        https://api.academiapro.com/api/
#
# If omitted:
#   - Vite development server on localhost:5173 defaults to http://localhost:8000/api/
#   - Production static builds default to same-origin `${window.location.origin}/api/`
VITE_API_BASE_URL=http://127.0.0.1:8000/api/

# ------------------------------------------------------------------------------
# UI & FEATURE FLAGS
# ------------------------------------------------------------------------------
# Display one-click demo credential autofill cards on the login page (Student/Faculty/Admin).
# Set to 'true' for evaluation/demo instances; set to 'false' in production.
VITE_SHOW_DEMO_CREDENTIALS=false
